
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      match /projects/{projectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    match /published_sites/{subdomainName} {
      // Leitura pública para visualização
      allow read, get, list: if true;
      
      // Permite criação pública (fluxo de rascunho)
      allow create: if true;
      
      // Permite atualização se:
      // 1. O site estiver pendente (Permite a liberação via Webhook sem auth)
      // 2. O usuário for o dono (Edição via Painel)
      // 3. A requisição for para liberar o site (status muda de pending para published)
      allow update: if 
        (resource.data.status == 'pending') || 
        (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.customerEmail == request.auth.token.email));
        
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
